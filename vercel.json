{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then VITE_LINE_AUTH_ENABLED=true npm run build; else npm run build; fi",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/g/:compactToken",
      "destination": "/gift-three-questions.html"
    }
  ]
}
