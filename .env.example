VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe is configured as Supabase Edge Function secrets, not in Vite:
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, APP_URL
# Stripe Products and Prices are created from commerce_products when needed.
# The webhook endpoint subscribes to checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired,
# and charge.refunded.
